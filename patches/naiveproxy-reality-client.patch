+// Decodes |hex| into |out|, which has room for |max_size| bytes. The decoded
+// value must be at least |min_size| bytes and the remaining bytes of |out| stay
+// zero, which is how REALITY short ids are right-zero-padded.
+bool HexDecode(std::string_view hex, size_t min_size, size_t max_size,
+               uint8_t* out) {
+  if (hex.empty()) {
+    return min_size == 0;
+  }
+  std::vector<uint8_t> bytes;
+  if (!base::HexStringToBytes(hex, &bytes) || bytes.size() < min_size ||
+      bytes.size() > max_size) {
+    return false;
+  }
+  std::copy(bytes.begin(), bytes.end(), out);
+  return true;
+}
