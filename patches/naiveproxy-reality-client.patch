+// Copyright 2025. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_SOCKET_REALITY_CONFIG_H_
+#define NET_SOCKET_REALITY_CONFIG_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// REALITY (https://github.com/XTLS/REALITY) client configuration. naive.exe
+// runs a single proxy configuration, so this is installed once at startup
+// instead of being plumbed through SSLConfig/CertVerifier; every
+// SSLClientSocketImpl then applies it.
+struct NET_EXPORT RealityConfig {
+  // Server static X25519 public key (32 bytes).
+  uint8_t public_key[32];
+  // Short id (8 bytes, right-zero-padded).
+  uint8_t short_id[8];
+};
+
+// Installs or clears the process-wide REALITY configuration. A nullopt disables
+// REALITY. Must be called before the IO thread (and thus any
+// SSLClientSocketImpl) starts; it is not synchronized with readers.
+NET_EXPORT void SetRealityConfig(std::optional<RealityConfig> config);
+
+// Returns the active configuration, or nullopt when REALITY is disabled.
+NET_EXPORT const std::optional<RealityConfig>& GetRealityConfig();
+
+}  // namespace net
+
+#endif  // NET_SOCKET_REALITY_CONFIG_H_
