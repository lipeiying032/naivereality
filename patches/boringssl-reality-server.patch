diff --git a/ssl/tls13_server.cc b/ssl/tls13_server.cc
index 88ad22b..5235451 100644
--- a/ssl/tls13_server.cc
+++ b/ssl/tls13_server.cc
@@ -989,6 +989,147 @@ static enum ssl_hs_wait_t do_read_second_client_hello(SSL_HANDSHAKE *hs) {
   return ssl_hs_ok;
 }
 
+// REALITY: rebuilds a mirrored ServerHello so that it agrees with this
+// connection's state. |mirror| points at a complete ServerHello handshake
+// message captured from the real target site. On success, |*out| is replaced
+// with a message that carries the mirrored random, cipher suite and extension
+// list, but this connection's legacy_session_id echo and key_share ciphertext.
+//
+// Returns true on success. On failure |*out| is left untouched and the caller
+// sends the ServerHello BoringSSL generated. This function only rewrites the
+// bytes that are sent; the handshake state machine is not touched.
+static bool reality_apply_server_hello(SSL_HANDSHAKE *hs, Array<uint8_t> *out,
+                                       const uint8_t *mirror,
+                                       size_t mirror_len) {
+  SSL *const ssl = hs->ssl;
+
+  CBS sh(Span<const uint8_t>(mirror, mirror_len)), body, mirror_random,
+      mirror_sid, mirror_cipher, mirror_compression, extensions;
+  uint8_t msg_type;
+  uint32_t body_len;
+  uint16_t legacy_version;
+  if (!CBS_get_u8(&sh, &msg_type) || msg_type != SSL3_MT_SERVER_HELLO ||
+      !CBS_get_u24(&sh, &body_len) ||
+      !CBS_get_bytes(&sh, &body, body_len) ||  //
+      CBS_len(&sh) != 0 ||
+      !CBS_get_u16(&body, &legacy_version) ||  //
+      !CBS_get_bytes(&body, &mirror_random, 32) ||
+      !CBS_get_u8_length_prefixed(&body, &mirror_sid) ||
+      !CBS_get_u16_length_prefixed(&body, &mirror_cipher) ||
+      !CBS_get_u8_length_prefixed(&body, &mirror_compression) ||
+      !CBS_get_u16_length_prefixed(&body, &extensions) ||  //
+      CBS_len(&body) != 0) {
+    return false;
+  }
+  if (CBS_len(&mirror_sid) > SSL_MAX_SSL_SESSION_ID_LENGTH ||
+      CBS_len(&mirror_cipher) != 2 || CBS_len(&mirror_compression) != 1) {
+    return false;
+  }
+
+  // Adopt the mirrored cipher suite only if this server knows it, it is a
+  // TLS 1.3 suite, and it uses the same hash as the transcript we have already
+  // initialized. Otherwise the mirrored bytes are rewritten below to name the
+  // cipher suite we negotiated, so that both sides hash the same handshake.
+  uint16_t cipher_value;
+  CBS cipher_cbs = mirror_cipher;
+  if (!CBS_get_u16(&cipher_cbs, &cipher_value)) {
+    return false;
+  }
+  const SSL_CIPHER *adopted = SSL_get_cipher_by_value(cipher_value);
+  const bool can_adopt =
+      adopted != nullptr &&
+      SSL_CIPHER_get_min_version(adopted) >= TLS1_3_VERSION &&
+      ssl_get_handshake_digest(ssl_protocol_version(ssl), adopted) ==
+          hs->transcript.Digest();
+
+  ScopedCBB cbb;
+  CBB out_body, out_sid, out_extensions;
+  if (!CBB_init(cbb.get(), mirror_len + 32) ||
+      !CBB_add_u8(cbb.get(), SSL3_MT_SERVER_HELLO) ||
+      !CBB_add_u24_length_prefixed(cbb.get(), &out_body) ||
+      !CBB_add_u16(&out_body, legacy_version) ||
+      !CBB_add_bytes(&out_body, CBS_data(&mirror_random), 32) ||
+      !CBB_add_u8_length_prefixed(&out_body, &out_sid) ||
+      !CBB_add_bytes(&out_sid, hs->session_id.data(), hs->session_id.size()) ||
+      !CBB_add_u16(&out_body,
+                   can_adopt ? cipher_value
+                             : SSL_CIPHER_get_protocol_id(hs->new_cipher)) ||
+      !CBB_add_bytes(&out_body, CBS_data(&mirror_compression), 1) ||
+      !CBB_add_u16_length_prefixed(&out_body, &out_extensions)) {
+    return false;
+  }
+
+  bool found_key_share = false;
+  bool found_supported_versions = false;
+  while (CBS_len(&extensions) > 0) {
+    uint16_t ext_type;
+    CBS ext_body;
+    if (!CBS_get_u16(&extensions, &ext_type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &ext_body)) {
+      return false;
+    }
+    // We never negotiated a PSK, so a mirrored PSK selection cannot be used.
+    if (ext_type == TLSEXT_TYPE_pre_shared_key) {
+      return false;
+    }
+    if (ext_type == TLSEXT_TYPE_key_share) {
+      CBS key_share = ext_body;
+      uint16_t group_id;
+      CBS peer_key;
+      if (!CBS_get_u16(&key_share, &group_id) ||
+          !CBS_get_u16_length_prefixed(&key_share, &peer_key) ||
+          CBS_len(&key_share) != 0) {
+        return false;
+      }
+      // The mirrored key share must be in the group we negotiated, and the
+      // server's own key share must have the same length, or it cannot be
+      // substituted. See RFC 8446, section 4.1.3.
+      if (group_id != hs->new_session->group_id ||
+          CBS_len(&peer_key) != hs->key_share_ciphertext.size()) {
+        return false;
+      }
+      CBB key_share_out, key_out;
+      if (!CBB_add_u16(&out_extensions, TLSEXT_TYPE_key_share) ||
+          !CBB_add_u16_length_prefixed(&out_extensions, &key_share_out) ||
+          !CBB_add_u16(&key_share_out, group_id) ||
+          !CBB_add_u16_length_prefixed(&key_share_out, &key_out) ||
+          !CBB_add_bytes(&key_out, hs->key_share_ciphertext.data(),
+                         hs->key_share_ciphertext.size())) {
+        return false;
+      }
+      found_key_share = true;
+      continue;
+    }
+    if (ext_type == TLSEXT_TYPE_supported_versions) {
+      found_supported_versions = true;
+    }
+    CBB ext_out;
+    if (!CBB_add_u16(&out_extensions, ext_type) ||
+        !CBB_add_u16_length_prefixed(&out_extensions, &ext_out) ||
+        !CBB_add_bytes(&ext_out, CBS_data(&ext_body), CBS_len(&ext_body))) {
+      return false;
+    }
+  }
+  if (!found_key_share || !found_supported_versions) {
+    return false;
+  }
+
+  Array<uint8_t> patched;
+  if (!CBBFinishArray(cbb.get(), &patched)) {
+    return false;
+  }
+
+  // Adopt the mirrored random and cipher suite so that the connection state
+  // matches the bytes we are about to send.
+  OPENSSL_memcpy(ssl->s3->server_random, CBS_data(&mirror_random), 32);
+  if (can_adopt) {
+    hs->new_cipher = adopted;
+    hs->new_session->cipher = adopted;
+  }
+  *out = std::move(patched);
+  return true;
+}
+
 static enum ssl_hs_wait_t do_send_server_hello(SSL_HANDSHAKE *hs) {
   SSL *const ssl = hs->ssl;
 
@@ -1047,6 +1188,19 @@ static enum ssl_hs_wait_t do_send_server_hello(SSL_HANDSHAKE *hs) {
                    ECH_CONFIRMATION_SIGNAL_LEN);
   }
 
+  // REALITY: optionally substitute a ServerHello mirrored from the real target
+  // site. This rewrites the message bytes only; the handshake state machine has
+  // already reached |state13_send_server_hello| and is unaffected. If the hook
+  // is not installed, or the mirrored message cannot be used,
+  // |reality_apply_server_hello| leaves |server_hello| untouched.
+  if (ssl->ctx->reality_cb != nullptr) {
+    const uint8_t *mirror = nullptr;
+    size_t mirror_len = 0;
+    if (ssl->ctx->reality_cb(ssl, &mirror, &mirror_len) && mirror != nullptr) {
+      reality_apply_server_hello(hs, &server_hello, mirror, mirror_len);
+    }
+  }
+
   if (!ssl->method->add_message(ssl, std::move(server_hello))) {
     return ssl_hs_error;
   }
