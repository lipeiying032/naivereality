diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index c45829c..46394b8 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5282,6 +5282,28 @@ OPENSSL_EXPORT void SSL_CTX_set_select_certificate_cb(
     SSL_CTX *ctx,
     enum ssl_select_cert_result_t (*cb)(const SSL_CLIENT_HELLO *));
 
+// reality_serverhello_cb is called on a server just before the ServerHello is
+// sent. If it returns one and sets |*out| and |*out_len| to a complete
+// ServerHello handshake message (including the four-byte handshake header),
+// BoringSSL sends a rewritten copy of that message instead of the ServerHello
+// it generated itself: the legacy_session_id echo and the key_share extension
+// are replaced with this connection's values, and the mirrored random and
+// cipher suite are adopted when the cipher suite is one this server can use
+// with the transcript hash already in progress. If the callback returns zero,
+// or the mirrored message cannot be used, the generated ServerHello is sent
+// unchanged.
+//
+// This is the REALITY mirroring hook. It only substitutes the bytes that go on
+// the wire; the handshake state machine is untouched, and the hook is inert
+// unless it is installed.
+typedef int (*reality_serverhello_cb)(SSL *ssl, const uint8_t **out,
+                                      size_t *out_len);
+
+// SSL_CTX_set_reality_serverhello_cb installs |cb| as the REALITY ServerHello
+// mirroring callback for |ctx|. See |reality_serverhello_cb| for details.
+OPENSSL_EXPORT void SSL_CTX_set_reality_serverhello_cb(
+    SSL_CTX *ctx, reality_serverhello_cb cb);
+
 // SSL_CTX_set_dos_protection_cb sets a callback that is called once the
 // resumption decision for a ClientHello has been made. It can return one to
 // allow the handshake to continue or zero to cause the handshake to abort.
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 74c901c..3f25e5b 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -5008,7 +5008,12 @@ bool tls1_choose_signature_algorithm(SSL_HANDSHAKE *hs,
     }
 
     if (std::find(peer_sigalgs.begin(), peer_sigalgs.end(), sigalg) !=
-        peer_sigalgs.end()) {
+            peer_sigalgs.end() ||
+        // REALITY: the temporary certificate is signed with Ed25519 even
+        // though clients such as Chrome do not advertise it. This carve-out is
+        // narrow (Ed25519 only) and is inert unless the REALITY ServerHello
+        // hook is installed. See |SSL_CTX_set_reality_serverhello_cb|.
+        (sigalg == SSL_SIGN_ED25519 && ssl->ctx->reality_cb != nullptr)) {
       *out = sigalg;
       return true;
     }
diff --git a/ssl/internal.h b/ssl/internal.h
